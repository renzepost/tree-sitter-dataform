{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "dataform",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "config_block"
          },
          {
            "type": "SYMBOL",
            "name": "js_block"
          },
          {
            "type": "SYMBOL",
            "name": "pre_operations_block"
          },
          {
            "type": "SYMBOL",
            "name": "post_operations_block"
          },
          {
            "type": "SYMBOL",
            "name": "statement"
          }
        ]
      }
    },
    "config_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "config"
        },
        {
          "type": "SYMBOL",
          "name": "braced_code"
        }
      ]
    },
    "js_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "js"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "{"
          },
          "named": true,
          "value": "open_brace"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "js_content"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "}"
          },
          "named": true,
          "value": "close_brace"
        }
      ]
    },
    "js_content": {
      "type": "ALIAS",
      "content": {
        "type": "SYMBOL",
        "name": "_js_content_raw"
      },
      "named": false,
      "value": "js_content"
    },
    "_js_content_raw": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[^{}]+"
          },
          {
            "type": "SYMBOL",
            "name": "_js_braced"
          }
        ]
      }
    },
    "_js_braced": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^{}]+"
              },
              {
                "type": "SYMBOL",
                "name": "_js_braced"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "pre_operations_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "pre_operations"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "{"
          },
          "named": true,
          "value": "open_brace"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "statement"
          }
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "}"
          },
          "named": true,
          "value": "close_brace"
        }
      ]
    },
    "post_operations_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "post_operations"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "{"
          },
          "named": true,
          "value": "open_brace"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "statement"
          }
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "}"
          },
          "named": true,
          "value": "close_brace"
        }
      ]
    },
    "braced_code": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^{}\"'`]+"
              },
              {
                "type": "SYMBOL",
                "name": "braced_code"
              },
              {
                "type": "SYMBOL",
                "name": "string"
              },
              {
                "type": "SYMBOL",
                "name": "comment"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "symbol"
        },
        {
          "type": "SYMBOL",
          "name": "interpolation"
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "number": {
      "type": "PATTERN",
      "value": "\\d+(\\.\\d+)?"
    },
    "symbol": {
      "type": "PATTERN",
      "value": "[.,;()=<>+\\-*/!\\[\\]]"
    },
    "open_brace": {
      "type": "STRING",
      "value": "{"
    },
    "close_brace": {
      "type": "STRING",
      "value": "}"
    },
    "interpolation": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "${"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^{}\"'`}]+"
              },
              {
                "type": "SYMBOL",
                "name": "braced_code"
              },
              {
                "type": "SYMBOL",
                "name": "string"
              },
              {
                "type": "SYMBOL",
                "name": "comment"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "string": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "\""
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[^\"\\\\]"
                  },
                  {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "STRING",
                        "value": "\\"
                      },
                      {
                        "type": "PATTERN",
                        "value": "."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "\""
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "'"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[^'\\\\]"
                  },
                  {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "STRING",
                        "value": "\\"
                      },
                      {
                        "type": "PATTERN",
                        "value": "."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "'"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "`"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[^`\\\\]"
                  },
                  {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "STRING",
                        "value": "\\"
                      },
                      {
                        "type": "PATTERN",
                        "value": "."
                      }
                    ]
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "`"
            }
          ]
        }
      ]
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "--"
              },
              {
                "type": "PATTERN",
                "value": ".*"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "//"
              },
              {
                "type": "PATTERN",
                "value": ".*"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "/*"
              },
              {
                "type": "PATTERN",
                "value": "[^*]*\\*+([^/*][^*]*\\*+)*"
              },
              {
                "type": "STRING",
                "value": "/"
              }
            ]
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}